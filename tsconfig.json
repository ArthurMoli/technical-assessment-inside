{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "~/server/*": ["./server/*"],
      "~/app/*": ["./app/*"]
    }
  },
  "include": ["app/**/*", "server/**/*", "tests/**/*", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "build"]
}
